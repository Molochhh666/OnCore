{
  "manifest_version": 3,
  "name": "OnCore",
  "version": "1.0.0",
  "description": "Live chart-canvas and screenshot news research sidebar.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://api.gdeltproject.org/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open OnCore"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}

